# loveaced 部署密钥模板:cp .env.example .env && 编辑。
# 生成 32 字节 hex:openssl rand -hex 32
# 本文件提交;真实 .env 永不提交(gitignore)。
# 经 env_file 注入容器——密钥不出现在任何命令行/进程列表里。
# 缺密钥或缺数据库时 loveaced 拒绝启动。仅本地一次性运行才设 LOVEACED_DEV=1
# (临时密钥 + 内存库,重启即丢失)。生产环境不要设置。

# loveaced 监听地址(容器内;compose 发布 127.0.0.1:8080)。
LOVEACED_ADDR=:8080

# 数据库连接。db 容器用 trust 认证且不发布端口(仅 compose 内网),
# 无密码可泄;主机侧管理走 podman exec。
LOVEACED_DATABASE_URL=postgres://loveace@db:5432/loveace?sslmode=disable

# 凭据保险库主密钥(KEK)。丢失 = 所有已存学校密码报废;务必备份到库外。
LOVEACED_KEK_HEX=

# 账号指纹 HMAC 的 pepper(不可逆;丢失只影响指纹匹配,可重置)。
LOVEACED_PEPPER_HEX=

# Ed25519 访问令牌种子。轮换会使全部 access token 失效(刷新令牌也在库内)。
LOVEACED_JWT_SEED_HEX=

# 管理端点令牌(/v1/admin/*)。不设 = 管理端点整体不存在(404)。
LOVEACED_ADMIN_TOKEN=

# 浏览器跨域白名单(逗号分隔的精确 origin;留空 = 无任何 CORS 头)。
LOVEACED_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173,http://127.0.0.1:5173

# 可信代理(逗号分隔的 CIDR)。只有来自这些地址的 X-Forwarded-For 才会被采信,
# 用于解析真实客户端地址(登录限流按它计数)。默认仅环回(宿主机 Caddy)。
# 容器内若看到的代理地址是网桥网关(如 10.89.0.1),需加入其所在网段。
# LOVEACED_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# 可选:单账号并发 UAAP 会话上限(§7.5,默认 5)。
# LOVEACED_SESSION_GROUP_SIZE=5

# 验证码原生化(M1/M3):模型路径指向 beta 的 common.onnx(~54MB,不进
# 仓库,放到宿主机后挂载进容器);空 = 撞验证码回退人工挑战。
# LOVEACED_CAPTCHA_MODEL=/data/captcha/common.onnx

# 判卷结果沉淀目录(金标/困难负样本,zstd 日切,自动轮转清理);
# 容器需对该目录可写(挂载卷属主 65534)。空 = 不沉淀。
# LOVEACED_CAPTCHA_STORE=/data/captcha/store
